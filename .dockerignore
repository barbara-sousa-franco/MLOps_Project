# What NOT to copy into the Docker image (keeps it small + no secrets).

# don't copy the Docker files themselves
Dockerfile
.dockerignore

# secrets — NEVER in the image (mlflow.yml is kept; only credentials/.env excluded)
.env
conf/**/*credentials*

# virtual environments
.venv
.venv-mlops

# caches / compiled
__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# data (mounted at runtime with -v), MLflow tracking, viz
data
mlruns
mlflow.db
.viz

# notebooks, git, OS
notebooks
*.ipynb
.git
.gitignore
.DS_Store
